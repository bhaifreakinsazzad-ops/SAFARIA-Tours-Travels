# ==============================================================================
# SAFARIA Tours & Travels — Environment Variables Specification
# Copy this file to .env.local for local development or set in deployment platform
# ==============================================================================

# Core Node Environment
NODE_ENV=production
PORT=3000

# Authentication & Session Security (MANDATORY in production; ephemeral fallbacks are blocked)
# Generate a 64-character high-entropy hex string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=e7b4c91038e4a9f123d6a782b49c018274f839a1c0d2e3f4a5b6c7d8e9f01234

# Internal Administrative Credentials
SAFARIA_ADMIN_SECRET=safaria_staff_admin_supersecret_2026
CRON_SECRET=safaria_cron_runner_secret_token_2026

# Database Connectivity (Supabase / Native PostgreSQL 18)
DATABASE_URL=postgres://postgres:password@localhost:5432/safaria
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# GoHighLevel CRM Integration (Optional in Staging; mock provider used if unset)
GHL_API_KEY=
GHL_LOCATION_ID=

# Safety & Financial Transaction Gates (STRICTLY GUARDED: Keep false until official authorization)
ENABLE_LIVE_PAYMENTS=false
ENABLE_LIVE_GDS_TICKETING=false
