# ==============================================================================
# SAFARIA Tours & Travels — Environment Variables Template (Vercel + Supabase)
# Copy to .env.local for local dev, or configure in Vercel Project Settings.
# Never commit real secret values to git.
# ==============================================================================

# --- Supabase Integration (Required for Production Persistence) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string with pooler/RLS support (optional for RLS-scoped queries)
DATABASE_URL=

# --- Session & Staff Security (Required in Production) ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=
ADMIN_API_KEY=
SAFARIA_ADMIN_SECRET=
# Optional Vercel Cron bearer secret (automatically sent by Vercel Cron when configured)
CRON_SECRET=

# --- Initial Super Admin Bootstrap (Recommended for Fresh Deployments) ---
# Logging in with this email + password automatically seeds the initial SUPER_ADMIN row in Supabase
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- GoHighLevel CRM Outbox Sync (Optional) ---
GHL_API_KEY=
GHL_ACCESS_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=

# --- Feature Safety Toggles ---
ENABLE_LIVE_GDS_TICKETING=
ENABLE_LIVE_PAYMENTS=