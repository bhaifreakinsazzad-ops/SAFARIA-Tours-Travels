# SAFARIA Tours & Travels — environment variables
# The public WhatsApp-only visitor journey needs none of these. They are
# required only to enable the server-side backend (auth, Supabase, CRM outbox).

# --- Session & staff auth (mandatory in production; see authService.ts / login/route.ts) ---
SESSION_SECRET=
SAFARIA_ADMIN_SECRET=
# Optional: grants SUPER_ADMIN to any request bearing this value in the
# x-safaria-admin-key header. Leave unset unless you need machine-to-machine admin access.
ADMIN_API_KEY=

# --- Supabase (required for durable persistence; falls back to in-memory store if unset) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional, additive: a direct Postgres connection string (Supabase dashboard
# -> Project Settings -> Database -> Connection string), DISTINCT from the
# REST URL + service-role key above. When set, B2B desk reads/writes for a
# partner's own agency run through a scoped `authenticated` connection so the
# existing Row-Level Security policies become a real, DB-enforced boundary
# instead of unused defense-in-depth (service-role bypasses RLS entirely).
# See server/db/scopedPgClient.ts.
DATABASE_URL=

# --- GoHighLevel CRM sync (optional; outbox entries queue in STAGING_MOCK_DISPATCHER mode if unset) ---
GHL_API_KEY=
GHL_ACCESS_TOKEN=
GHL_LOCATION_ID=
# Opportunity creation is additionally gated on these two — leave unset until
# the business owner provisions a real GHL pipeline for SAFARIA leads.
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=

# --- Cron ---
# Shared secret required by /api/cron/dispatch-outbox; set this to match the
# Authorization header configured on whatever scheduler calls the route.
CRON_SECRET=

# --- Safety gates (strictly OFF by default; see server/config/featureFlags.ts) ---
ENABLE_LIVE_PAYMENTS=false
ENABLE_LIVE_GDS_TICKETING=false
